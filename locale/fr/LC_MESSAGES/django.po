#: .\templates\account\email\unknown_account_message.txt:4
#, python-format
msgid ""
"You are receiving this email because you, or someone else, tried to access "
"an account with email %(email)s. However, we do not have any record of such "
"an account in our database."
msgstr ""
"Vous recevez cet e-mail parce que vous ou quelqu'un d'autre avez essayé d'accéder\n"
"à un compte avec l'e-mail %(email)s. Cependant, nous n'avons aucune trace\n"
"d'un tel compte dans notre base de données."

#: .\templates\account\email\unknown_account_message.txt:8
msgid "If it was you, you can sign up for an account using the link below."
msgstr "Si c'était vous, vous pouvez créer un compte en utilisant le lien ci-dessous."

